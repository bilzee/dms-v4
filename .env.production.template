# Production Environment Configuration Template
# Copy this file to .env.production and fill in actual values

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NEXT_PUBLIC_APP_NAME="Disaster Response Management System (DRMS)"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NODE_ENV=production

# ===========================================
# PWA SETTINGS
# ===========================================
NEXT_PUBLIC_PWA_ENABLED=true

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# PostgreSQL Connection String for Production
# Generate strong password: openssl rand -base64 24
DATABASE_URL="postgresql://username:password@production-db-host:5432/disaster_management_prod?schema=public&sslmode=require"

# Docker Compose uses these instead:
DB_USER="drms_user"
DB_PASSWORD="REPLACE-WITH-STRONG-PASSWORD"

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# Generate strong secrets for production:
# - JWT_SECRET: Use `openssl rand -base64 64`
# - NEXTAUTH_SECRET: Use `openssl rand -base64 32`
JWT_SECRET="REPLACE-WITH-STRONG-64-CHAR-SECRET"
JWT_EXPIRES_IN="24h"
NEXTAUTH_SECRET="REPLACE-WITH-STRONG-32-CHAR-SECRET"
NEXTAUTH_URL="https://your-production-domain.com"

# ===========================================
# API SETTINGS
# ===========================================
NEXT_PUBLIC_API_URL="https://your-production-domain.com/api"

# ===========================================
# SECURITY HEADERS
# ===========================================
ENABLE_SECURITY_HEADERS=true

# ===========================================
# MINIO / S3 OBJECT STORAGE
# ===========================================
# MinIO endpoint (Docker internal URL when using docker-compose)
# For Dokploy: use the Docker service name "minio"
S3_ENDPOINT="http://minio:9000"
# Generate strong MinIO credentials: openssl rand -base64 24
MINIO_ROOT_USER="REPLACE-WITH-MINIO-USER"
MINIO_ROOT_PASSWORD="REPLACE-WITH-MINIO-PASSWORD"
S3_ACCESS_KEY="same-as-MINIO_ROOT_USER"
S3_SECRET_KEY="same-as-MINIO_ROOT_PASSWORD"
S3_BUCKET="dms-storage"
S3_REGION="us-east-1"
S3_ENABLED=true

# ===========================================
# REDIS
# ===========================================
REDIS_URL="redis://redis:6379"
REDIS_ENABLED=true

# ===========================================
# SENTRY ERROR MONITORING
# ===========================================
# Create free account at https://sentry.io
# Free tier: 5k events/month, 1 project
# Paste the DSN from Project Settings > Client Keys
SENTRY_DSN=""
SENTRY_ENABLED=false

# ===========================================
# EMAIL SERVICE
# ===========================================
# Choose one provider: "resend" or "sendgrid"
# Both offer 100 emails/day on free tier
#
# Resend (recommended): https://resend.com
# SendGrid: https://sendgrid.com
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS="noreply@your-domain.com"
EMAIL_FROM_NAME="DRMS"

# ===========================================
# EXTERNAL S3 BACKUP
# ===========================================
# Offsite backup destination (AWS S3, Cloudflare R2, Wasabi, etc.)
# Leave empty to disable — backups go to local MinIO only
BACKUP_S3_ENDPOINT=""
BACKUP_S3_ACCESS_KEY=""
BACKUP_S3_SECRET_KEY=""
BACKUP_S3_BUCKET=""
BACKUP_S3_REGION=""
BACKUP_S3_ENABLED=false

# ===========================================
# SSL / LET'S ENCRYPT
# ===========================================
# Email for Let's Encrypt certificate notifications
ACME_EMAIL="admin@your-domain.com"

# ===========================================
# BACKUP & MAINTENANCE
# ===========================================
# Database backup runs as Docker sidecar
# Backups go to MinIO db-backups bucket automatically
# Retention: 30 days
DB_BACKUP_ENABLED=true
